{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storvaultos-website",
  "main": "branding-worker.mjs",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html"
    ],
    "not_found_handling": "none"
  }
}
