{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storvaultos-website",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": false }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
